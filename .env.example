# Env vars read by `docker-compose.yml` (the prod stack) for interpolation.
# Docker Compose auto-loads a `.env` file from this directory (next to
# docker-compose.yml) — copy this to `.env` and fill in real values before
# running `docker compose up`. Never commit the real `.env`.

# Required: Django SECRET_KEY. Compose refuses to start the backend service
# if this is unset (fails closed) rather than falling back to a known,
# publicly-committed placeholder.
SECRET_KEY=

# Optional: comma-separated list of allowed hosts for the prod deploy.
# Defaults to localhost,127.0.0.1 if unset — set this to your real domain(s).
ALLOWED_HOSTS=localhost,127.0.0.1
